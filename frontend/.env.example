NODE_ENV=development
WATCHPACK_POLLING="true"
BACKEND_URL=site-backend
#Uncomment this line if you want to run the frontend locally without docker
#BACKEND_URL=http://127.0.0.1

# Keycloak integration
REACT_APP_BACKEND_API="http://127.0.0.1:4007"
REACT_APP_AUTH_AUTHORITY="<secret>"  # Ask for this one.
REACT_APP_AUTH_CLIENT_ID="epd-local"
REACT_APP_AUTH_REDIRECT_URI="http://127.0.0.1:4000"
REACT_APP_AUTH_LOGOUT_REDIRECT_URI="<secret>"  # Ask for this one.
REACT_APP_AUTH_RESPONSE_TYPE="code"
REACT_APP_AUTH_SCOPE="openid profile"
REACT_APP_AUTH_FILTER_PROTOCOL_CLAIMS="true"
REACT_APP_AUTH_LOAD_USER_INFO="true"
REACT_APP_AUTH_REVOKE_TOKENS_ON_SIGNOUT="true"
REACT_APP_SITE_REGISTRAR_USER_ROLE="site-site-registrar"
