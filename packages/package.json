{
  "name": "bcgov-epd-components",
  "description": "A modular React component library for building flexible and customizable srs web applications with built-in support for common UI elements like headers, form, table, and more.",
  "author": "Jaspal Singh",
  "homepage": "https://github.com/jaspalsingh-aot/epd-react-components",
  "bugs": "https://github.com/jaspalsingh-aot/epd-react-components/issues",
  "version": "1.0.4",
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "npm run rollup && npm run post:build && echo 'use npm publish ./dist to publish directory'",
    "post:build": "node ./scripts/postBuild.js",
    "rollup": "rollup -c --bundleConfigAsCjs",
    "prepublishOnly": "npm run build",
    "postpublish": "echo 'Successfully published to npm!'",
    "test": "jest --passWithNoTests"
  },
  "keywords": [
    "@govbc",
    "EPD"
  ],
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-bootstrap": "^0.32.37",
    "@types/uuid": "^10.0.0",
    "lint-staged": "^15.2.7",
    "postcss-url": "^10.1.3",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.2",
    "react-icons": "^4.12.0",
    "rollup": "^4.24.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-generate-package-json": "^3.2.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-url": "^3.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "uuid": "^9.0.1"
  },
  "peerDependencies": {
    "@bcgov/bc-sans": "^1.0.1",
    "@bcgov/design-tokens": "^2.0.1",
    "bootstrap": "^5.2.2",
    "react": "^18.3.1",
    "react-bootstrap": "2.10.2",
    "react-router-dom": "^6.4.1",
    "rsuite": "^5.74.2"
  },
  "dependencies": {
    "@types/uuid": "^9.0.8",
    "clsx": "^2.1.1",
    "react-bootstrap": "2.10.2",
    "react-icons": "^4.12.0"
  }
}
